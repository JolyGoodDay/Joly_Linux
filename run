#!/bin/bash
set -e

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$REPO/venv"

python3 -m venv "$VENV"
source "$VENV/bin/activate"
pip install --quiet --upgrade pip
pip install --quiet -r "$REPO/requirements.txt"

case "${1:-}" in
    i3)
        ansible-playbook -K -i "$REPO/ansible/inventory.yaml" \
            -e "joly_linux_dir=$REPO" \
            "$REPO/ansible/playbooks/i3.yaml"
        ;;
    *)
        ansible-playbook -K -i "$REPO/ansible/inventory.yaml" \
            -e "joly_linux_dir=$REPO" \
            "$REPO/ansible/playbooks/playbook.yaml"
        ;;
esac
